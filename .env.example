# Base URL of the ErinsList Netlify Functions. Defaults to production if unset.
VITE_SWEETSUITE_API_BASE=https://erinslist.netlify.app/.netlify/functions

# Shared secret sent as the X-SweetSuite-Key header. Must match SWEETSUITE_API_KEY
# set in the ErinsList (recipe repo) Netlify environment variables.
VITE_SWEETSUITE_API_KEY=

# URL of SweetSuite's own backend (see backend/README.md) — the second Netlify
# site deployed from this repo's backend/ folder. No trailing slash.
VITE_BACKEND_URL=

# Shared secret sent as X-SweetSuite-Key to the backend's calendar-events endpoint.
# Must match BACKEND_API_KEY set on that Netlify site. Use a DIFFERENT value than
# VITE_SWEETSUITE_API_KEY above — these are two independent systems.
VITE_BACKEND_API_KEY=
